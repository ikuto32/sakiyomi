{
  "name": "sakiyomi",
  "description": "Sakiyomi (先読み): desktop shogi GUI for USI engines",
  "version": "0.3.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test:layout": "esbuild src/layout.ts --bundle --format=esm --outfile=target/layout-test/layout.mjs --log-level=warning && node tests/layout.test.mjs",
    "test:i18n": "esbuild src/i18n.ts --bundle --format=esm --outfile=target/i18n-test/i18n.mjs --log-level=warning && node tests/i18n.test.mjs",
    "test": "npm run test:layout && npm run test:i18n"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
